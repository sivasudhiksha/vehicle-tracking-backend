# Environment Configuration
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS Configuration (comma-separated origins or * for open development)
CORS_ORIGINS=*

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/vehicle_tracking

# JWT Authentication Configuration
SECRET_KEY=YOUR_SECRET_KEY_HEX_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=vehicles/+/gps

